{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        { "slug": "ink", "name": "文字", "color": "#1f2a22" },
        { "slug": "ink-soft", "name": "文字(薄)", "color": "#5b6156" },
        { "slug": "accent", "name": "オレンジ", "color": "#d98f2b" },
        { "slug": "accent-soft", "name": "オレンジ(薄)", "color": "#f3ddb0" },
        { "slug": "accent2", "name": "グリーン", "color": "#3e6e6b" },
        { "slug": "accent2-soft", "name": "グリーン(薄)", "color": "#d8e6e3" },
        { "slug": "surface", "name": "白", "color": "#fbfbf6" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fontSizes": [
        { "slug": "small", "name": "小", "size": "0.875rem" },
        { "slug": "medium", "name": "中", "size": "1rem" },
        { "slug": "large", "name": "大", "size": "1.25rem" }
      ]
    },
    "layout": {
      "contentSize": "720px"
    }
  },
  "styles": {
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "#241505"
        },
        "border": { "radius": "999px" },
        "spacing": {
          "padding": { "top": "14px", "right": "26px", "bottom": "14px", "left": "26px" }
        },
        "typography": { "fontSize": "14.5px", "fontWeight": "700" },
        ":hover": {
          "color": { "background": "#c17f21" }
        }
      }
    }
  }
}